# Server only. Put real values in .env.local or private Vercel environment variables.
DATABASE_URL=postgresql://USER:PASSWORD@NEON-POOLER-HOST/DATABASE?sslmode=require
SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_PASSWORD=SET_A_PRIVATE_ADMIN_PASSWORD

# Shared configuration (questions, links, both matrices) and their versions.
# Disabled by default; local works only outside production/Vercel.
MATRICES_STORAGE=disabled
# Development only: MATRICES_STORAGE=local
# MATRICES_LOCAL_DIR=.local-matrices
# BISA_API_PORT=3002
# BISA_WEB_PORT=5173
# npm run dev inicia API y web en un solo proceso; carga .env.matrices.local
# y las credenciales administrativas existentes de .env.neon-test.local.
# No carga .env ni .env.neon-production.local; no importa rutas de base de datos.
# Enable Blob only after plan, budget and target store have been approved.
# MATRICES_STORAGE=blob
# MATRICES_BLOB_APPROVED=true
# BLOB_READ_WRITE_TOKEN=SERVER_ONLY_PRIVATE_TEST_STORE_TOKEN
# Or use a connected private store with BLOB_STORE_ID + VERCEL_OIDC_TOKEN.

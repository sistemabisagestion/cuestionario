{
  "name": "quiz-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --configLoader runner",
    "dev:matrices": "node --watch --env-file-if-exists=.env.neon-test.local --env-file=.env.matrices.local scripts/dev-matrices.mjs",
    "matrices:recover": "node scripts/recover-matrices.mjs --initialize-local",
    "dev:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.neon-test.local --env-file-if-exists=.env.local scripts/dev-api.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "test:concurrencia": "node scripts/verify-concurrency.mjs",
    "test:neon": "node --env-file-if-exists=.env.neon-test.local scripts/test-neon.mjs",
    "build": "tsc -b && vite build --configLoader runner",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.3",
    "exceljs": "^4.4.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
